<Window x:Class="ProxyManager.Standalone.RuleImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxyManager.Standalone.Localization"
        Title="{x:Static loc:Strings.ImportPreviewTitle}" Width="720" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        MinWidth="560" MinHeight="360"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.ImportPreviewTitle}"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.ImportPreviewIntro}"
                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.ImportPreviewColumnProcess}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.ImportPreviewColumnMode}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.ImportPreviewColumnCondition}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="{x:Static loc:Strings.ImportPreviewColumnDisposition}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
                <ListBox x:Name="RowsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{x:Static loc:Strings.ImportPreviewTitle}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="36" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ExeName}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ModeText}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding ConditionSummary}" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding DispositionText}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="NothingText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                       Text="{x:Static loc:Strings.ImportPreviewNothingToAdd}" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static loc:Strings.ImportPreviewCancel}"
                    Click="Cancel_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static loc:Strings.ImportPreviewCancel}"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                    Content="{x:Static loc:Strings.ImportPreviewConfirm}" Click="Confirm_Click"
                    AutomationProperties.Name="{x:Static loc:Strings.ImportPreviewConfirm}"/>
        </StackPanel>
    </Grid>
</Window>
