                                <Button Grid.Row="0" Grid.Column="3" Content="{x:Static loc:Strings.PolicyReanalyze}" Style="{StaticResource SecondaryBtn}" Padding="8,6" VerticalAlignment="Bottom" Margin="0,0,6,0" Click="AnalyzePolicy_Click"/>
                                <Button Grid.Row="0" Grid.Column="4" x:Name="PolicyLocateButton" Content="{x:Static loc:Strings.PolicyLocate}" Style="{StaticResource SecondaryBtn}" Padding="8,6" VerticalAlignment="Bottom" IsEnabled="False" Click="LocatePolicyRule_Click"/>
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Background="#143B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Static loc:Strings.PolicyPrivacyNote}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

