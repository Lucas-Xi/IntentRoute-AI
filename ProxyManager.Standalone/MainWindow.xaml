                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PolicyAiSummaryText" Text="{x:Static loc:Strings.PolicyAiSummaryInitial}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></ScrollViewer>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Static loc:Strings.PolicyAdviceTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                    <ListView Grid.Row="1" x:Name="PolicyAiAdviceList" Background="Transparent" BorderThickness="0">
