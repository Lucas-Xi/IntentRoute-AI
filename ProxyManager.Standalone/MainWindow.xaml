                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,13,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.RouteReasonLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="RouteDecisionReasonText" Text="{x:Static loc:Strings.RouteReasonInitial}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,13,0,0">
                                        <TextBlock Text="{x:Static loc:Strings.RouteSnapshotLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="RouteDecisionSnapshotText" Text="{x:Static loc:Strings.RouteSnapshotInitial}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="6" x:Name="RouteDecisionLocateButton" Content="{x:Static loc:Strings.RouteLocate}"
                                            Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                            IsEnabled="False" AutomationProperties.Name="{x:Static loc:Strings.RouteLocateName}" Click="LocateRouteDecisionRule_Click"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="14,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="{x:Static loc:Strings.RouteTraceTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock x:Name="RouteDecisionTraceCountText" Text="0 条" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <ListView x:Name="RouteDecisionTraceList" Background="Transparent" BorderThickness="0"
                                                  AutomationProperties.Name="{x:Static loc:Strings.RouteTraceTitle}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="{x:Static loc:Strings.RouteTraceColOrder}" Width="55" DisplayMemberBinding="{Binding Order}"/>
                                                    <GridViewColumn Header="{x:Static loc:Strings.RouteTraceColRule}" Width="155" DisplayMemberBinding="{Binding RuleName}"/>
                                                    <GridViewColumn Header="{x:Static loc:Strings.RouteTraceColConclusion}" Width="90" DisplayMemberBinding="{Binding Evaluation}"/>
                                                    <GridViewColumn Header="{x:Static loc:Strings.RouteTraceColReason}" Width="260" DisplayMemberBinding="{Binding Reason}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <TextBlock x:Name="RouteDecisionTraceEmptyText" Text="{x:Static loc:Strings.RouteTraceEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock x:Name="RouteDecisionStatusText" Text="{x:Static loc:Strings.RouteStatusInitial}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,120,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="RouteDecisionCancelButton" Content="取消" Style="{StaticResource SecondaryBtn}"
                                        HorizontalAlignment="Right" IsEnabled="False" AutomationProperties.Name="取消本地路由推演"
                                        Click="CancelRouteSimulation_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: sing-box 运行日志 -->
                    <Grid x:Name="PageMonitor" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.MonitorTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="{x:Static loc:Strings.MonitorExport}" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Margin="0,0,8,0"
                                                        AutomationProperties.Name="{x:Static loc:Strings.MonitorExportAutomation}" Click="ExportLogs_Click"/>
                                                <Button Content="{x:Static loc:Strings.MonitorClear}" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Click="ClearLogs_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="{x:Static loc:Strings.MonitorSearchLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="LogSearchBox" Width="200" Style="{StaticResource InputBox}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                     TextChanged="LogSearch_Changed" AutomationProperties.Name="{x:Static loc:Strings.MonitorSearchLabel}"/>
                                            <TextBlock Text="{x:Static loc:Strings.MonitorFilterLevel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <ComboBox x:Name="LogLevelFilterCombo" Width="110" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      SelectionChanged="LogLevelFilter_Changed" AutomationProperties.Name="{x:Static loc:Strings.MonitorFilterLevel}"/>
                                            <CheckBox x:Name="LogAutoScrollToggle" Content="{x:Static loc:Strings.MonitorAutoScroll}" IsChecked="True" IsThreeState="False"
                                                      FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListView Grid.Row="1" x:Name="LogsList" Background="Transparent" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static loc:Strings.MonitorColTime}" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                            <GridViewColumn Header="{x:Static loc:Strings.MonitorColMessage}" Width="620" DisplayMemberBinding="{Binding Message}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: 进程列表 -->
                    <Grid x:Name="PageProcess" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.ProcessTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="ProcessSearchBox" Width="180" Style="{StaticResource InputBox}" FontSize="11" VerticalAlignment="Center"
                                                     TextChanged="ProcessSearch_Changed" AutomationProperties.Name="{x:Static loc:Strings.ProcessSearchLabel}"/>
                                            <Button x:Name="ProcessAddRuleButton" Content="{x:Static loc:Strings.ProcessAddRule}" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Margin="8,0,0,0"
                                                    IsEnabled="False" AutomationProperties.Name="{x:Static loc:Strings.ProcessAddRuleAutomation}" Click="AddRuleFromProcess_Click"/>
                                            <TextBlock x:Name="ProcessCount" Text="0 个进程" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                            <Button Content="{x:Static loc:Strings.ProcessRefresh}" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Click="RefreshProcess_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListView Grid.Row="1" x:Name="ProcessList" Background="Transparent" BorderThickness="0" SelectionChanged="ProcessList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static loc:Strings.ProcessColPid}" Width="80" DisplayMemberBinding="{Binding Pid}"/>
                                            <GridViewColumn Header="{x:Static loc:Strings.ProcessColName}" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="{x:Static loc:Strings.ProcessColPath}" Width="300" DisplayMemberBinding="{Binding Path}"/>
                                            <GridViewColumn Header="{x:Static loc:Strings.ProcessColStatus}" Width="175" DisplayMemberBinding="{Binding Status}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: 设置 -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel>
                                <!-- sing-box 就绪状态 -->
                                <Border x:Name="RuntimeSettingsCard" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsRuntimeTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsRuntimeIntro}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RuntimePathBox" Grid.Column="0" IsReadOnly="True"
                                                     Style="{StaticResource InputBox}" ToolTip="{x:Static loc:Strings.SettingsRuntimePathTooltip}"/>
                                            <Button Grid.Column="1" Content="{x:Static loc:Strings.SettingsRuntimeBrowse}" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="BrowseSingBox_Click"/>
                                            <Button x:Name="RefreshRuntimeButton" Grid.Column="2" Content="{x:Static loc:Strings.SettingsRuntimeRecheck}" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="RefreshRuntime_Click"/>
                                            <Button Grid.Column="3" Content="{x:Static loc:Strings.SettingsRuntimeClear}" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="ClearSingBoxPath_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="RuntimeVersionText" Text="{x:Static loc:Strings.SettingsRuntimeVersionUnchecked}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="RuntimeReadinessText" Text="{x:Static loc:Strings.SettingsRuntimeChecking}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- AI 提供方健康诊断 -->
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsAiHealthTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsAiHealthIntro}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <Button x:Name="AiHealthCheckButton" Content="{x:Static loc:Strings.SettingsAiHealthRun}" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="AiHealthCheck" AutomationProperties.Name="运行 AI 提供方健康诊断"
                                                Click="AiHealthCheck_Click"/>
                                        <TextBlock x:Name="AiHealthText" Text="{x:Static loc:Strings.SettingsAiHealthNotRun}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 本地代理设置 -->
                                <Border x:Name="ProxySettingsCard" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsProxyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsProxyIntro}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{x:Static loc:Strings.SettingsProxyType}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ProxyTypeCombo" Style="{StaticResource InputCombo}" SelectedIndex="0">
                                                    <ComboBoxItem Content="SOCKS5" Tag="Socks5"/>
                                                    <ComboBoxItem Content="HTTP" Tag="Http"/>
                                                    <ComboBoxItem Content="HTTPS" Tag="Https"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{x:Static loc:Strings.SettingsProxyHost}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyHost" Text="127.0.0.1" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Static loc:Strings.SettingsProxyPort}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyPort" Text="10808" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{x:Static loc:Strings.SettingsProxyUsername}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyUsername" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Static loc:Strings.SettingsProxyPassword}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="ProxyPassword" Style="{StaticResource InputPassBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="{x:Static loc:Strings.SettingsProxySave}" Style="{StaticResource PrimaryBtn}"
                                                    Margin="0,0,8,0" Click="SaveProxy_Click"/>
                                            <Button x:Name="TestProxyButton" Content="{x:Static loc:Strings.SettingsProxyTest}" Style="{StaticResource SecondaryBtn}"
                                                    Click="TestProxy_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ProxyTestStatus" Text="{x:Static loc:Strings.SettingsProxyTestHint}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 语言 -->
                                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsLanguageTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{x:Static loc:Strings.SettingsLanguageIntro}"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="LanguageCombo" Style="{StaticResource InputCombo}" MaxWidth="260" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="LanguageSelector" AutomationProperties.Name="显示语言选择"
                                                  SelectionChanged="Language_Changed">
                                            <ComboBoxItem Content="{x:Static loc:Strings.SettingsLanguageChinese}" Tag="zh"/>
                                            <ComboBoxItem Content="{x:Static loc:Strings.SettingsLanguageEnglish}" Tag="en"/>
                                            <ComboBoxItem Content="{x:Static loc:Strings.SettingsLanguageFollowSystem}" Tag="system"/>
                                        </ComboBox>
                                        <TextBlock x:Name="LanguageSavedHint" Text="" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 页面: 关于 -->
                    <Grid x:Name="PageAbout" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="32">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="IntentRoute AI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:Strings.AboutTagline}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeaturesTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature1}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature2}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature3}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature4}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature5}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature6}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature7}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{x:Static loc:Strings.AboutFeature8}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{x:Static loc:Strings.AboutFooter}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
