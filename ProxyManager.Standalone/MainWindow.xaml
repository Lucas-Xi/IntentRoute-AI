                                <StackPanel><TextBlock Text="{x:Static loc:Strings.PolicyStatActive}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyActiveCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
