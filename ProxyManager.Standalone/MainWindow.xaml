                                    <ListView x:Name="PolicyFindingsList" Background="Transparent" BorderThickness="0" SelectionMode="Extended" SelectionChanged="PolicyFindingSelection_Changed">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{x:Static loc:Strings.PolicyColSeverity}" Width="60" DisplayMemberBinding="{Binding Severity}"/>
