                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static loc:Strings.AiColDomain}" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding TargetHosts, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0" Background="Transparent" FontSize="11" Padding="2,2"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static loc:Strings.AiColIp}" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding TargetIps, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0" Background="Transparent" FontSize="11" Padding="2,2"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static loc:Strings.PortLabel}" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding TargetPorts, UpdateSourceTrigger=PropertyChanged}"
