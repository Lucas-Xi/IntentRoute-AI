                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,170,0"/>
                                <Button x:Name="AiAcceptButton" Content="{x:Static loc:Strings.AiAcceptLabel}" Style="{StaticResource PrimaryBtn}"
                                        IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AcceptAiRules_Click"
                                        AutomationProperties.AutomationId="AiAccept" AutomationProperties.Name="将 AI 草案添加为禁用规则"/>
                            </Grid>
                        </Border>
                    </Grid>

