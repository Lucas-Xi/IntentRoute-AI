<Window x:Class="ProxyManager.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxyManager.Standalone.Localization"
        Title="{x:Static loc:Strings.WindowTitle}" Height="720" Width="1040"
        MinHeight="500" MinWidth="750"
        Background="#0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 颜色定义 -->
        <Color x:Key="BgColor">#0F0F0F</Color>
        <Color x:Key="SurfaceColor">#161616</Color>
        <Color x:Key="CardColor">#1C1C1C</Color>
        <Color x:Key="HoverColor">#222222</Color>
        <Color x:Key="AccentColor">#3B82F6</Color>
        <Color x:Key="AccentHoverColor">#2563EB</Color>
        <Color x:Key="SuccessColor">#22C55E</Color>
        <Color x:Key="WarningColor">#EAB308</Color>
        <Color x:Key="DangerColor">#EF4444</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
        <Color x:Key="TextMutedColor">#71717A</Color>
        <Color x:Key="BorderColor">#27272A</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- 导航按钮样式 -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,10" Margin="0,2"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 右键菜单 -->
        <ContextMenu x:Key="RuleMenu" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
            <MenuItem Header="{x:Static loc:Strings.MenuToggleEnabled}" Click="ToggleRule_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceProxy}" Click="SetProxy_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceDirect}" Click="SetDirect_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuForceBlock}" Click="SetBlock_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuMoveUp}" Click="MoveUp_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuMoveDown}" Click="MoveDown_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="{x:Static loc:Strings.MenuDelete}" Click="DeleteRule_Click" Foreground="{StaticResource DangerBrush}"/>
        </ContextMenu>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧导航栏 ═══ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo区域 -->
                    <Border Grid.Row="0" Padding="18,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="✦ IntentRoute AI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{x:Static loc:Strings.SidebarVersion}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航菜单 -->
                    <StackPanel Grid.Row="1" Margin="10,16,10,0">
                        <RadioButton x:Name="NavRules" Content="{x:Static loc:Strings.NavItemRules}" GroupName="Nav" IsChecked="True"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavRules" AutomationProperties.Name="{x:Static loc:Strings.NavItemRules}"/>
                        <RadioButton x:Name="NavPolicy" Content="{x:Static loc:Strings.NavItemPolicy}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavPolicy" AutomationProperties.Name="{x:Static loc:Strings.NavItemPolicy}"/>
                        <RadioButton x:Name="NavRouteSimulator" Content="{x:Static loc:Strings.NavItemRouteSimulator}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavRouteSimulator" AutomationProperties.Name="{x:Static loc:Strings.NavItemRouteSimulator}"/>
                        <RadioButton x:Name="NavAi" Content="{x:Static loc:Strings.NavItemAi}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavAi" AutomationProperties.Name="{x:Static loc:Strings.NavItemAi}"/>
                        <RadioButton x:Name="NavMonitor" Content="{x:Static loc:Strings.NavItemMonitor}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavMonitor" AutomationProperties.Name="{x:Static loc:Strings.NavItemMonitor}"/>
                        <RadioButton x:Name="NavProcess" Content="{x:Static loc:Strings.NavItemProcess}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavProcess" AutomationProperties.Name="{x:Static loc:Strings.NavItemProcess}"/>
                        <RadioButton x:Name="NavSettings" Content="{x:Static loc:Strings.NavItemSettings}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="{x:Static loc:Strings.NavItemSettings}"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,16,8,12"/>

                        <RadioButton x:Name="NavAbout" Content="{x:Static loc:Strings.NavItemAbout}" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"
                                     AutomationProperties.AutomationId="NavAbout" AutomationProperties.Name="{x:Static loc:Strings.NavItemAbout}"/>
                    </StackPanel>

                    <!-- 底部状态 -->
                    <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusLabel" Text="{x:Static loc:Strings.StatusFooterLabel}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Text="{x:Static loc:Strings.StatusFooterInitial}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 右侧内容区 ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 -->
                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="20,12,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 标题 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="PageTitle" Text="{x:Static loc:Strings.PageTitleRules}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="PageSubtitle" Text="{x:Static loc:Strings.PageSubtitleRules}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,6"/>
                        </StackPanel>

                        <!-- 全局模式切换 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeDirect" Content="{x:Static loc:Strings.ModeDirectLabel}" GroupName="Mode" IsChecked="True"
                                                 Style="{StaticResource NavButton}" Click="Mode_Changed" FontSize="12"/>
                                    <RadioButton x:Name="ModeProxy" Content="{x:Static loc:Strings.ModeProxyLabel}" GroupName="Mode"
                                                 Style="{StaticResource NavButton}" Click="Mode_Changed" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 窗口控制 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="—" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="16" Width="32" Height="28" Cursor="Hand"
                                    AutomationProperties.AutomationId="WindowMinimize" AutomationProperties.Name="{x:Static loc:Strings.WindowMinimizeName}"
                                    Click="Minimize_Click"/>
                            <Button Content="□" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="14" Width="32" Height="28" Cursor="Hand"
                                    AutomationProperties.AutomationId="WindowMaximize" AutomationProperties.Name="{x:Static loc:Strings.WindowMaximizeName}"
                                    Click="Maximize_Click"/>
                            <Button Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="14" Width="32" Height="28" Cursor="Hand"
                                    AutomationProperties.AutomationId="WindowClose" AutomationProperties.Name="{x:Static loc:Strings.WindowCloseName}"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 配置恢复阻断提示 -->
                <Border x:Name="ConfigRecoveryBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="#3D2E00" BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="16,8,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static loc:Strings.RecoveryBannerTitle}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="ConfigRecoveryText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{x:Static loc:Strings.RecoveryOpenFolder}" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="OpenConfigFolder_Click"/>
                            <Button x:Name="RecoverConfigButton" Content="{x:Static loc:Strings.RecoveryImport}" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="RecoverConfig_Click"/>
                            <Button x:Name="ResetConfigButton" Content="{x:Static loc:Strings.RecoveryReset}" Style="{StaticResource PrimaryBtn}" Padding="10,5"
                                    Click="ResetConfig_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主内容区 -->
                <Grid Grid.Row="2" Margin="16,8,16,16">
                    <!-- 页面: 规则管理 -->
                    <Grid x:Name="PageRules" Visibility="Visible" AllowDrop="True"
                          Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8"
                                Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 搜索框 -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox" Width="200"
                                             Style="{StaticResource InputBox}" FontSize="12"
                                             TextChanged="Search_Changed"/>
                                    <TextBlock x:Name="SearchPlaceholder" Text="{x:Static loc:Strings.RulesSearchPlaceholder}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="11,0,0,0"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- 统计信息 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A3B82F6" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="ProxyCount" Text="代理: 0" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Border Background="#1A22C55E" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="DirectCount" Text="直连: 0" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <Border Background="#1AEF4444" CornerRadius="4" Padding="8,3">
                                        <TextBlock x:Name="BlockCount" Text="阻止: 0" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{x:Static loc:Strings.RulesAdd}" Style="{StaticResource PrimaryBtn}"
                                            Click="AddRule_Click" Margin="0,0,8,0"/>
                                    <Button Content="{x:Static loc:Strings.RulesImport}" Style="{StaticResource SecondaryBtn}"
                                            Click="Import_Click" Margin="0,0,8,0"/>
                                    <Button Content="{x:Static loc:Strings.RulesExport}" Style="{StaticResource SecondaryBtn}"
                                            Click="Export_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BatchEnableButton" Content="{x:Static loc:Strings.RulesBatchEnable}" Style="{StaticResource SecondaryBtn}"
                                            Margin="0,0,8,0" IsEnabled="False"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchEnableAutomation}" Click="BatchEnable_Click"/>
                                    <Button x:Name="BatchDisableButton" Content="{x:Static loc:Strings.RulesBatchDisable}" Style="{StaticResource SecondaryBtn}"
                                            Margin="0,0,8,0" IsEnabled="False"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchDisableAutomation}" Click="BatchDisable_Click"/>
                                    <Button x:Name="BatchDeleteButton" Content="{x:Static loc:Strings.RulesBatchDelete}" Style="{StaticResource SecondaryBtn}"
                                            Margin="0,0,8,0" IsEnabled="False" Foreground="{StaticResource DangerBrush}"
                                            AutomationProperties.Name="{x:Static loc:Strings.RulesBatchDeleteAutomation}" Click="BatchDelete_Click"/>
                                    <Button Content="{x:Static loc:Strings.RulesClear}" Style="{StaticResource SecondaryBtn}"
                                            Click="Clear_Click" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 规则列表 -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <!-- 表头 -->
                                <Border VerticalAlignment="Top" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.RulesHeaderApp}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.RulesHeaderMode}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.RulesHeaderStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Static loc:Strings.RulesHeaderTime}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- 列表内容 -->
                                <ListBox x:Name="RulesList" Margin="0,38,0,0" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Extended" SelectionChanged="RulesList_SelectionChanged"
                                         ContextMenu="{StaticResource RuleMenu}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#263B82F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="48" Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,5">
                                                    <TextBlock Text="{Binding ExeName}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExePath}"/>
                                                    <TextBlock Text="{Binding ConditionSummary}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ModeText}" FontSize="11"
                                                           Foreground="{Binding ModeColor}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="⋮" FontSize="16"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="{x:Static loc:Strings.RulesRowMenuHint}"/>
                                            </Grid>
