                                <StackPanel><TextBlock Text="{x:Static loc:Strings.PolicyStatCritical}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyCriticalCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="{x:Static loc:Strings.PolicyStatWarning}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyWarningCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14">
                                <StackPanel><TextBlock Text="{x:Static loc:Strings.PolicyStatDisabled}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyDisabledCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
