<Window x:Class="ProxyManager.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntentRoute AI - Windows 智能分流" Height="720" Width="1040"
        MinHeight="500" MinWidth="750"
        Background="#0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 颜色定义 -->
        <Color x:Key="BgColor">#0F0F0F</Color>
        <Color x:Key="SurfaceColor">#161616</Color>
        <Color x:Key="CardColor">#1C1C1C</Color>
        <Color x:Key="HoverColor">#222222</Color>
        <Color x:Key="AccentColor">#3B82F6</Color>
        <Color x:Key="AccentHoverColor">#2563EB</Color>
        <Color x:Key="SuccessColor">#22C55E</Color>
        <Color x:Key="WarningColor">#EAB308</Color>
        <Color x:Key="DangerColor">#EF4444</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
        <Color x:Key="TextMutedColor">#71717A</Color>
        <Color x:Key="BorderColor">#27272A</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- 导航按钮样式 -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,10" Margin="0,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 右键菜单 -->
        <ContextMenu x:Key="RuleMenu" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
            <MenuItem Header="切换启用" Click="ToggleRule_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="🔵 强制代理" Click="SetProxy_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="🟢 强制直连" Click="SetDirect_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="🔴 阻止联网" Click="SetBlock_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="⬆ 上移" Click="MoveUp_Click" Foreground="{StaticResource TextBrush}"/>
            <MenuItem Header="⬇ 下移" Click="MoveDown_Click" Foreground="{StaticResource TextBrush}"/>
            <Separator Background="{StaticResource BorderBrush}"/>
            <MenuItem Header="❌ 删除" Click="DeleteRule_Click" Foreground="{StaticResource DangerBrush}"/>
        </ContextMenu>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧导航栏 ═══ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo区域 -->
                    <Border Grid.Row="0" Padding="18,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="✦ IntentRoute AI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="v0.3.0 开发预览版" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航菜单 -->
                    <StackPanel Grid.Row="1" Margin="10,16,10,0">
                        <RadioButton x:Name="NavRules" Content="📋  规则管理" GroupName="Nav" IsChecked="True"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavPolicy" Content="◈  AI 策略体检" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavAi" Content="✦  AI 规则助手" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavMonitor" Content="📋  运行日志" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavProcess" Content="⚙️  进程列表" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                        <RadioButton x:Name="NavSettings" Content="🔧  设置" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,16,8,12"/>

                        <RadioButton x:Name="NavAbout" Content="ℹ️  关于" GroupName="Nav"
                                     Style="{StaticResource NavButton}" Click="Nav_Click"/>
                    </StackPanel>

                    <!-- 底部状态 -->
                    <Border Grid.Row="2" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusLabel" Text="运行状态" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Text="正在检查 sing-box…" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 右侧内容区 ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏 -->
                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="20,12,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 标题 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="PageTitle" Text="规则管理" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="PageSubtitle" Text=" - 拖拽 .exe 添加规则" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,6"/>
                        </StackPanel>

                        <!-- 全局模式切换 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeDirect" Content="默认直连" GroupName="Mode" IsChecked="True"
                                                 Style="{StaticResource NavButton}" Click="Mode_Changed" FontSize="12"/>
                                    <RadioButton x:Name="ModeProxy" Content="默认代理" GroupName="Mode"
                                                 Style="{StaticResource NavButton}" Click="Mode_Changed" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 窗口控制 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="—" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="16" Width="32" Height="28" Cursor="Hand"
                                    Click="Minimize_Click"/>
                            <Button Content="□" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="14" Width="32" Height="28" Cursor="Hand"
                                    Click="Maximize_Click"/>
                            <Button Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="14" Width="32" Height="28" Cursor="Hand"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 配置恢复阻断提示 -->
                <Border x:Name="ConfigRecoveryBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="#3D2E00" BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="16,8,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="配置保护已启动" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="ConfigRecoveryText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开目录" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="OpenConfigFolder_Click"/>
                            <Button x:Name="RecoverConfigButton" Content="导入有效配置" Style="{StaticResource SecondaryBtn}" Padding="10,5"
                                    Margin="0,0,6,0" Click="RecoverConfig_Click"/>
                            <Button x:Name="ResetConfigButton" Content="明确重置" Style="{StaticResource PrimaryBtn}" Padding="10,5"
                                    Click="ResetConfig_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主内容区 -->
                <Grid Grid.Row="2" Margin="16,8,16,16">
                    <!-- 页面: 规则管理 -->
                    <Grid x:Name="PageRules" Visibility="Visible" AllowDrop="True"
                          Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8"
                                Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 搜索框 -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox" Width="200"
                                             Style="{StaticResource InputBox}" FontSize="12"
                                             TextChanged="Search_Changed"/>
                                    <TextBlock x:Name="SearchPlaceholder" Text="🔍 搜索规则..."
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="11,0,0,0"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- 统计信息 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A3B82F6" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="ProxyCount" Text="代理: 0" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Border Background="#1A22C55E" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="DirectCount" Text="直连: 0" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <Border Background="#1AEF4444" CornerRadius="4" Padding="8,3">
                                        <TextBlock x:Name="BlockCount" Text="阻止: 0" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="➕ 添加规则" Style="{StaticResource PrimaryBtn}"
                                            Click="AddRule_Click" Margin="0,0,8,0"/>
                                    <Button Content="📥 导入" Style="{StaticResource SecondaryBtn}"
                                            Click="Import_Click" Margin="0,0,8,0"/>
                                    <Button Content="📤 导出" Style="{StaticResource SecondaryBtn}"
                                            Click="Export_Click" Margin="0,0,8,0"/>
                                    <Button Content="🗑 清空" Style="{StaticResource SecondaryBtn}"
                                            Click="Clear_Click" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 规则列表 -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <!-- 表头 -->
                                <Border VerticalAlignment="Top" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="应用程序" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="模式" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="状态" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="添加时间" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <!-- 列表内容 -->
                                <ListBox x:Name="RulesList" Margin="0,38,0,0" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ContextMenu="{StaticResource RuleMenu}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#263B82F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="48" Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,5">
                                                    <TextBlock Text="{Binding ExeName}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExePath}"/>
                                                    <TextBlock Text="{Binding ConditionSummary}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ModeText}" FontSize="11"
                                                           Foreground="{Binding ModeColor}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CreatedAt}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="⋮" FontSize="16"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip="选择后右键管理规则"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空状态 -->
                                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="拖拽 .exe 文件到此处" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="或点击上方「添加规则」按钮" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 拖拽覆盖层 -->
                                <Border x:Name="DropOverlay" Background="#990F0F0F" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="释放以添加规则" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: AI 规则助手 -->
                    <Grid x:Name="PageAiAssistant" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="AI 提供商" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AiProviderCombo" Style="{StaticResource InputCombo}"
                                              Background="#F3F4F6" Foreground="#111827"
                                              SelectionChanged="AiProvider_Changed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#111827"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="模型" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AiModelCombo" Style="{StaticResource InputCombo}"
                                              Background="#F3F4F6" Foreground="#111827">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#111827"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="2" Content="刷新模型" Style="{StaticResource SecondaryBtn}" Padding="12,6"
                                        VerticalAlignment="Bottom" Margin="0,0,14,0" Click="RefreshAiModels_Click"/>
                                <Border Grid.Column="3" Background="#1422C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <TextBlock x:Name="AiPrivacyText" Text="只发送你输入的意图和静态规则格式；不会发送代理凭据、现有规则、日志或进程列表。"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="用自然语言描述分流意图" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="示例：让 Chrome 和 Cursor 访问 GitHub、OpenAI 时走代理，其他流量保持直连。"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8"/>
                                <TextBox x:Name="AiIntentBox" Style="{StaticResource InputBox}" Height="82"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         MaxLength="2000"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="AiCancelButton" Content="取消" Style="{StaticResource SecondaryBtn}"
                                            IsEnabled="False" Click="CancelAi_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="AiGenerateButton" Content="生成并本地校验" Style="{StaticResource PrimaryBtn}"
                                            Click="GenerateAi_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="AI 草案预览（未写入、未启用）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="AiDraftCount" Text="0 条规则" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>
                                <ListView Grid.Row="1" x:Name="AiDraftList" Background="Transparent" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="进程" Width="115" DisplayMemberBinding="{Binding ProcessName}"/>
                                            <GridViewColumn Header="动作" Width="60" DisplayMemberBinding="{Binding Action}"/>
                                            <GridViewColumn Header="条件" Width="260" DisplayMemberBinding="{Binding Conditions}"/>
                                            <GridViewColumn Header="理由" Width="235" DisplayMemberBinding="{Binding Rationale}"/>
                                            <GridViewColumn Header="置信度" Width="65" DisplayMemberBinding="{Binding Confidence}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock x:Name="AiStatusText" Text="AI 生成的内容必须经过本地校验和人工确认。"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,170,0"/>
                                <Button x:Name="AiAcceptButton" Content="添加为禁用规则" Style="{StaticResource PrimaryBtn}"
                                        IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AcceptAiRules_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: AI 策略体检 -->
                    <Grid x:Name="PagePolicyIntelligence" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="155"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="活动规则" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyActiveCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="高风险" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyCriticalCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="需复核" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyWarningCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14">
                                <StackPanel><TextBlock Text="禁用草案" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock x:Name="PolicyDisabledCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="AI 提供商" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PolicyProviderCombo" Style="{StaticResource InputCombo}" Background="#F3F4F6" Foreground="#111827" SelectionChanged="PolicyProvider_Changed">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#111827"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="模型" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PolicyModelCombo" Style="{StaticResource InputCombo}" Background="#F3F4F6" Foreground="#111827">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#111827"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="2" Content="刷新模型" Style="{StaticResource SecondaryBtn}" Padding="8,6" VerticalAlignment="Bottom" Margin="0,0,6,0" Click="RefreshPolicyModels_Click"/>
                                <Button Grid.Row="0" Grid.Column="3" Content="重新体检" Style="{StaticResource SecondaryBtn}" Padding="8,6" VerticalAlignment="Bottom" Margin="0,0,6,0" Click="AnalyzePolicy_Click"/>
                                <Button Grid.Row="0" Grid.Column="4" x:Name="PolicyLocateButton" Content="定位规则" Style="{StaticResource SecondaryBtn}" Padding="8,6" VerticalAlignment="Bottom" IsEnabled="False" Click="LocatePolicyRule_Click"/>
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Background="#143B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                    <TextBlock Text="本地列表显示真实规则；AI 只收到计数、发现编号、类型、等级和关系，不含进程、目标、端口、ID、路径或代理信息。" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="14,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid><TextBlock Text="本地确定性发现" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="PolicyFindingCount" Text="0 项" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/></Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <ListView x:Name="PolicyFindingsList" Background="Transparent" BorderThickness="0" SelectionMode="Extended" SelectionChanged="PolicyFindingSelection_Changed">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="等级" Width="60" DisplayMemberBinding="{Binding Severity}"/>
                                                <GridViewColumn Header="编号" Width="65" DisplayMemberBinding="{Binding Code}"/>
                                                <GridViewColumn Header="问题" Width="170" DisplayMemberBinding="{Binding Title}"/>
                                                <GridViewColumn Header="受影响规则" Width="150" DisplayMemberBinding="{Binding AffectedRules}"/>
                                                <GridViewColumn Header="证据与下一步" Width="320" DisplayMemberBinding="{Binding Guidance}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="PolicyEmptyText" Text="未发现可确定的问题。策略体检不等同于真实流量验证。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.32*"/><ColumnDefinition Width="0.68*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="AI 解读摘要（只读）" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PolicyAiSummaryText" Text="先完成本地体检，再由你明确选择是否发送结构摘要给 AI。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></ScrollViewer>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="按本地发现编号给出的优先建议" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                    <ListView Grid.Row="1" x:Name="PolicyAiAdviceList" Background="Transparent" BorderThickness="0">
                                        <ListView.View><GridView><GridViewColumn Header="编号" Width="60" DisplayMemberBinding="{Binding Code}"/><GridViewColumn Header="解释" Width="180" DisplayMemberBinding="{Binding Explanation}"/><GridViewColumn Header="安全下一步" Width="220" DisplayMemberBinding="{Binding SafeNextStep}"/><GridViewColumn Header="置信度" Width="60" DisplayMemberBinding="{Binding Confidence}"/></GridView></ListView.View>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10">
                            <Grid>
                                <TextBlock x:Name="PolicyStatusText" Text="体检完全在本地运行，不调用 AI，也不修改配置。" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,270,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PolicyCancelButton" Content="取消解读" Style="{StaticResource SecondaryBtn}" IsEnabled="False" Margin="0,0,8,0" Click="CancelPolicyExplanation_Click"/>
                                    <Button x:Name="PolicyExplainButton" Content="让 AI 解读所选摘要" Style="{StaticResource PrimaryBtn}" IsEnabled="False" Click="ExplainPolicy_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: sing-box 运行日志 -->
                    <Grid x:Name="PageMonitor" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="sing-box 运行日志" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="清空" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Click="ClearLogs_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListView Grid.Row="1" x:Name="LogsList" Background="Transparent" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                            <GridViewColumn Header="消息" Width="620" DisplayMemberBinding="{Binding Message}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: 进程列表 -->
                    <Grid x:Name="PageProcess" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="运行中的进程" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock x:Name="ProcessCount" Text="0 个进程" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="刷新" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Click="RefreshProcess_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListView Grid.Row="1" x:Name="ProcessList" Background="Transparent" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding Pid}"/>
                                            <GridViewColumn Header="进程名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="路径" Width="300" DisplayMemberBinding="{Binding Path}"/>
                                            <GridViewColumn Header="配置候选（未按目标求值）" Width="175" DisplayMemberBinding="{Binding Status}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 页面: 设置 -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel>
                                <!-- sing-box 就绪状态 -->
                                <Border x:Name="RuntimeSettingsCard" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="sing-box 就绪状态" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="IntentRoute AI 不包含也不会下载 sing-box。每次启动都需通过“浏览…”重新批准你单独安装并验证过的 v1.13+ 可执行文件。"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RuntimePathBox" Grid.Column="0" IsReadOnly="True"
                                                     Style="{StaticResource InputBox}" ToolTip="已批准路径，或尚待你通过“浏览…”按钮批准的发现候选"/>
                                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="BrowseSingBox_Click"/>
                                            <Button x:Name="RefreshRuntimeButton" Grid.Column="2" Content="重新检查" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="RefreshRuntime_Click"/>
                                            <Button Grid.Column="3" Content="清除选择" Style="{StaticResource SecondaryBtn}"
                                                    Margin="8,0,0,0" Click="ClearSingBoxPath_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="RuntimeVersionText" Text="版本：尚未检查" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="RuntimeReadinessText" Text="正在检查…" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 本地代理设置 -->
                                <Border x:Name="ProxySettingsCard" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="本地代理设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="仅支持已经运行在本机字面量回环地址上的 SOCKS5 / HTTP / HTTPS 代理；不提供代理节点或账号。"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="类型" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ProxyTypeCombo" Style="{StaticResource InputCombo}" SelectedIndex="0">
                                                    <ComboBoxItem Content="SOCKS5" Tag="Socks5"/>
                                                    <ComboBoxItem Content="HTTP" Tag="Http"/>
                                                    <ComboBoxItem Content="HTTPS" Tag="Https"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="回环 IP 地址" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyHost" Text="127.0.0.1" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="端口" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyPort" Text="10808" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="用户名（可选）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="ProxyUsername" Style="{StaticResource InputBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="密码（可选，使用 Windows DPAPI 保存）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <PasswordBox x:Name="ProxyPassword" Style="{StaticResource InputPassBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="保存代理设置" Style="{StaticResource PrimaryBtn}"
                                                    Margin="0,0,8,0" Click="SaveProxy_Click"/>
                                            <Button x:Name="TestProxyButton" Content="测试端口" Style="{StaticResource SecondaryBtn}"
                                                    Click="TestProxy_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ProxyTestStatus" Text="测试只检查本机端口能否连接，不会发送凭据，也不代表认证或真实流量成功。"
                                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 页面: 关于 -->
                    <Grid x:Name="PageAbout" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="32">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="IntentRoute AI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="AI 辅助 Windows 网络分流 v0.3.0" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="功能特性" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="• 拖拽添加应用程序规则" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 支持代理/直连/阻止三种模式" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 实时进程监控" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 规则导入导出" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• OpenAI / 本地 Ollama 自然语言规则草案" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 严格本地校验，草案默认禁用" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• 本地策略体检与可选的去标识 AI 解读" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• sing-box TUN 数据面（需单独安装）" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="基于 .NET 8 + WPF 构建" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
