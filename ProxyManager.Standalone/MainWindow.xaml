                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#111827"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{x:Static loc:Strings.ModelLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
