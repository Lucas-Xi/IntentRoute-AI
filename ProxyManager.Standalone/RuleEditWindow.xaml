<Window x:Class="ProxyManager.Standalone.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxyManager.Standalone.Localization"
        Title="{x:Static loc:Strings.RuleEditTitle}" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.RuleEditTitle}"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditProcessLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProcessNameText"
                   FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditHostsLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,12">
            <TextBox x:Name="HostsBox" Style="{StaticResource InputBox}" TextChanged="Field_Changed"
                     AutomationProperties.Name="{x:Static loc:Strings.RuleEditHostsLabel}"/>
            <TextBlock Text="{x:Static loc:Strings.RuleEditHostsHint}" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditIpsLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,12">
            <TextBox x:Name="IpsBox" Style="{StaticResource InputBox}" TextChanged="Field_Changed"
                     AutomationProperties.Name="{x:Static loc:Strings.RuleEditIpsLabel}"/>
            <TextBlock Text="{x:Static loc:Strings.RuleEditIpsHint}" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditPortsLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,12">
            <TextBox x:Name="PortsBox" Style="{StaticResource InputBox}" TextChanged="Field_Changed"
                     AutomationProperties.Name="{x:Static loc:Strings.RuleEditPortsLabel}"/>
            <TextBlock Text="{x:Static loc:Strings.RuleEditPortsHint}" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditProtocolLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ProtocolBox" Style="{StaticResource InputCombo}"
                  HorizontalAlignment="Left" MinWidth="160" Margin="0,4,0,12"
                  SelectionChanged="ProtocolBox_SelectionChanged"
                  AutomationProperties.Name="{x:Static loc:Strings.RuleEditProtocolLabel}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static loc:Strings.RuleEditNoteLabel}"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="NoteBox" Style="{StaticResource InputBox}"
                 Margin="0,4,0,12" TextChanged="Field_Changed"
                 AutomationProperties.Name="{x:Static loc:Strings.RuleEditNoteLabel}"/>

        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" x:Name="ErrorText"
                   Foreground="{StaticResource ErrorBrush}" FontSize="11.5" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="{x:Static loc:Strings.RuleEditCancel}"
                    Click="Cancel_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static loc:Strings.RuleEditCancel}"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                    Content="{x:Static loc:Strings.RuleEditSave}" Click="Save_Click"
                    AutomationProperties.Name="{x:Static loc:Strings.RuleEditSave}"/>
        </StackPanel>
    </Grid>
</Window>
